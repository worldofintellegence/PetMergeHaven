# GitHub Pages repo for Pet Merge Haven (web build for QA).
# Allow-list: ignore everything, then un-ignore only the files the web page needs.
# Keeps the Android signing key (android/upload-keystore.jks, keystore.properties),
# desktop/Steam builds, dist/, docs and tooling out of the repo.
/*

!/.gitignore
!/.gitattributes
!/.nojekyll
!/index.html
!/style.css
!/art.js
!/game.js
!/platform.js
!/fonts/

.DS_Store
